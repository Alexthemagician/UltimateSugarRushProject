; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ultimate Sugar Rush"
run/main_scene="res://scenes/app/boot_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

SaveSystem="*res://scripts/core/save_system.gd"
GameDatabase="*res://scripts/core/game_database.gd"
GameSettings="*res://scripts/core/game_settings.gd"
SceneRouter="*res://scripts/core/scene_router.gd"
CollectibleRewards="*res://scripts/core/collectible_rewards.gd"
CafeProgress="*res://scripts/core/cafe_progress.gd"
CafeLife="*res://scripts/core/cafe_life.gd"
CafeRetention="*res://scripts/core/cafe_retention.gd"
CafeOnline="*res://scripts/core/cafe_online.gd"
AdmobClient="*res://scenes/app/admob_client.tscn"
RewardedAds="*res://scripts/core/rewarded_ads.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/AdmobPlugin/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
